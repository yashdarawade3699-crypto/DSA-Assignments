#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

int parent[20];

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

int main() {
    int n, e;
    Edge a[50];

    cout << "Enter vertices and edges: ";
    cin >> n >> e;

    for (int i = 0; i < e; i++) {
        cout << "Enter u, v and weight: ";
        cin >> a[i].u >> a[i].v >> a[i].w;
    }

    sort(a, a + e, [](Edge x, Edge y) {
        return x.w < y.w;
    });

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int cost = 0;

    cout << "\nMinimum Spanning Tree:\n";

    for (int i = 0; i < e; i++) {
        int x = find(a[i].u);
        int y = find(a[i].v);

        if (x != y) {
            cout << a[i].u << " - " << a[i].v
                 << " : " << a[i].w << endl;

            parent[x] = y;
            cost += a[i].w;
        }
    }

    cout << "Total Cost: " << cost;

    return 0;
}
